async function getRoot(mrk){
  var shipping = "SELECT * FROM `ideal-data-warehouse.centra.shipping_rates` WHERE marketId = " + mrk.code + " AND code = '" + mrk.curr + "' AND '" + mrk.iso + "' IN UNNEST(countries) ORDER BY value ASC LIMIT 1";
  if (mrk.iso == "") shipping = "SELECT * FROM `ideal-data-warehouse.centra.shipping_rates` WHERE marketId = " + mrk.code + " AND code = '" + mrk.curr + "' ORDER BY value ASC LIMIT 1";
  var query = "SELECT DISTINCT t0.brand AS brandname, CAST(t0.createdAt AS STRING) AS createdAt, CASE WHEN t0.isBundle THEN t12.ean ELSE t0.ean END AS ean, CASE WHEN t0.isBundle THEN IFNULL(t12.google_merchant_category, '') ELSE IFNULL(t0.google_merchant_category, '') END AS google_merchant_category, t0.id AS productId, IFNULL(t0.sa_dynamic_badges,'') as sa_dynamic_badges, IFNULL(CAST(t10.displayItemId AS STRING),'') AS dispid, t0.name AS product, IFNULL(t0.sa_algolia_ranking, '') AS sa_algolia_ranking, IFNULL(t0.collection, '') AS collection, IFNULL(t0.sa_collection, '') AS sa_collection, IFNULL(t0.sa_family, '') AS sa_family, IFNULL(t0.sa_gender, '') AS sa_gender, IFNULL(t0.sa_hidden, '0') AS sa_hidden, IFNULL(t0.sa_manufacturer, '') AS sa_manufacturer, IFNULL(t0.sa_model, '') AS sa_model, IFNULL(t0.sa_new_product, '0') AS sa_new_product, IFNULL(t0.sa_pattern, '') AS sa_pattern, IFNULL(t0.sa_phone_compatibility, '') AS sa_phone_compatibility, IFNULL(t0.sa_product_group, '') AS sa_product_group, IFNULL(t0.sa_type, '') AS sa_type, IFNULL(CONCAT(t1.localized." + mrk.short + ".name, ' > ', t2.localized." + mrk.short + ".name), '') AS category_1, t0.sku, CASE WHEN t0.isBundle THEN t12.sku ELSE t0.sku END AS mpn, t0.weight, CASE WHEN CAST(t5." + mrk.warehouse + " AS STRING) != '0' THEN 'in stock' ELSE 'out of stock' END AS availability, IFNULL(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(t6.description, '<ul>',''), '</ul>',''), '</li>',''), ' <li>',' * '), '<br/><br/>',''), t0.description) AS description, IFNULL(t0.frontImage, '') AS image_link, IFNULL(t7.urls,[]) AS additional_image_links, IFNULL(CONCAT('" + mrk.link + "',t10.uri), '') AS link, IFNULL(CONCAT(ROUND(t8.price," + mrk.price_denominator + "), ' ', t8.currency), '') AS price, IFNULL( CASE WHEN t9.type = 'PERCENT' AND t9.startAt <= CURRENT_TIMESTAMP() AND t9.stopAt >= CURRENT_TIMESTAMP() THEN CAST(CONCAT((ROUND(t8.price *(1-(t9.discountPercent/100))," + mrk.price_denominator + ")), ' ', t8.currency) AS STRING) WHEN t9.type = 'FIXED_PRICE' AND t9.startAt <= CURRENT_TIMESTAMP() AND t9.stopAt >= CURRENT_TIMESTAMP() THEN CAST(t9.fixedPrice AS STRING) ELSE '' END ,'') AS sale_price, IFNULL(CONCAT(FORMAT_DATETIME('%Y-%m-%dT%H:%M+0000',DATETIME (PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', substr(STRING(t9.startAt), 0 ,19), 'Europe/Stockholm')) ), '/', FORMAT_DATETIME('%Y-%m-%dT%H:%M+0000',DATETIME (PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', substr(STRING(t9.stopAt), 0 ,19), 'Europe/Stockholm')) )),'') AS sale_price_effective_date, CASE WHEN t9.startAt <= CURRENT_TIMESTAMP() AND t9.stopAt >= CURRENT_TIMESTAMP() THEN true ELSE false END AS sale_price_currently_active,CASE WHEN t13.salesrank IS NULL THEN FALSE ELSE TRUE END AS bestseller,CASE WHEN t13.salesrank IS NOT NULL AND t0.sa_gender = 'Male' THEN TRUE ELSE FALSE END AS male_bestseller, IFNULL(t10.name, '') AS display_name, t8.currency AS currency, t0.name AS title, IFNULL(t3.revenue_" + mrk.rev + ", 0) AS sales_revenue_last7day, IFNULL(t3.quantity_" + mrk.rev + ", 0) AS sales_quantity_last7day, '" + mrk.iso + "' AS country_iso_3166, IFNULL(t5." + mrk.warehouse + ", 0) AS stock_level, IFNULL(CONCAT(t4.value, ' ', t4.code), '') AS shipping_cost, 'new' AS condition FROM ( SELECT * FROM `ideal-data-warehouse.centra.products_root` WHERE status = 'ACTIVE') t0 LEFT JOIN ( SELECT * EXCEPT(RN) FROM ( SELECT localized, prim, category, inCategory, name, ROW_NUMBER() OVER (PARTITION BY prim ORDER BY sortOrder DESC ) RN FROM `ideal-data-warehouse.centra.categories`, UNNEST(primaryProducts) AS prim WHERE localized." + mrk.short + ".name IS NOT NULL) WHERE RN = 1) t1 ON t1.prim = t0.id LEFT JOIN ( SELECT * EXCEPT(RN) FROM ( SELECT localized, inCategory, category, ROW_NUMBER() OVER (PARTITION BY inCategory ORDER BY sortOrder DESC ) RN FROM `ideal-data-warehouse.centra.categories` WHERE localized." + mrk.short + ".name IS NOT NULL) WHERE RN = 1) t2 ON t2.inCategory = t1.category LEFT JOIN `ideal-data-warehouse.aggregations.sevendayrev_exmoms` t3 ON t0.sku = t3.sku LEFT JOIN (" + shipping + ") t4 ON t4.marketId = " + mrk.code + " LEFT JOIN `ideal-data-warehouse.centra.stock` t5 ON t0.sku = t5.sku LEFT JOIN `ideal-data-warehouse.centra.products_localized` t6 ON t0.sku = t6.sku AND t6.language = UPPER('" + mrk.local + "') AND t6.description IS NOT NULL LEFT JOIN (SELECT displayid, ARRAY_AGG(url) AS urls FROM `ideal-data-warehouse.centra.products_displays_media` GROUP BY displayid) t7 ON CAST(t0.frontDisplay AS STRING) = t7.displayid LEFT JOIN `ideal-data-warehouse.centra.products_prices` t8 ON t0.sku = t8.sku AND t8.id = '" + mrk.price + "' LEFT JOIN (SELECT * EXCEPT(RN) FROM ( SELECT *, ROW_NUMBER() OVER (PARTITION BY product ORDER BY startAt ASC ) RN FROM `ideal-data-warehouse.centra.products_campaigns` WHERE startAt <= CURRENT_TIMESTAMP() AND stopAt >= CURRENT_TIMESTAMP() AND " + parseInt(mrk.code) + " IN UNNEST(markets)) WHERE RN = 1) t9 ON t0.id = t9.product LEFT JOIN `ideal-data-warehouse.centra.products_displays_root` t10 ON t0.frontDisplay = t10.id LEFT JOIN `ideal-data-warehouse.centra.products_bundles_products` t11 ON t0.id = t11.id AND t11.primary LEFT JOIN `ideal-data-warehouse.centra.products_root` t12 ON t11.bundle_product_id = t12.id LEFT JOIN `ideal-data-warehouse.aggregations.vw_salesrank_by_display` t13 ON t10.displayItemId IN UNNEST(t13.dispId) AND t13.marketId = " + parseInt(mrk.code) + " AND t13.salesrank <= 100 WHERE " + parseInt(mrk.code) + " IN UNNEST(t10.markets)";
  console.log(mrk.count, query);
  var options = {
    query: query,
    location: 'EU',
  };
  var [job] = await bigquery.createQueryJob(options);
  var [rows] = await job.getQueryResults();
  return rows;
}
async function getCats(lang){
  var query = "WITH fruits AS(SELECT primary_products,CASE WHEN STARTS_WITH(t1.completeUri, 'categories/sale') IS NOT TRUE AND t2.localized." + lang + ".name IS NOT NULL THEN Ifnull(Concat(t2.localized." + lang + ".name, ' > ',t1.localized." + lang + ".name),Ifnull(Concat(t2.localized." + lang + ".name, ' > ',t1.name),t2.localized." + lang + ".name)) ELSE '' END AS level2, CASE WHEN STARTS_WITH(t1.completeUri, 'categories/sale') AND t2.localized." + lang + ".name IS NOT NULL THEN Ifnull(Concat(t2.localized." + lang + ".name, ' > ',t1.localized." + lang + ".name),Ifnull(Concat(t2.localized." + lang + ".name, ' > ',t1.name),t2.localized." + lang + ".name)) ELSE '' END AS sale, t1.sortorder + t2.sortorder + t3.sortorder AS sort FROM `ideal-data-warehouse.centra.categories` t1 LEFT JOIN unnest(t1.primaryproducts) AS primary_products LEFT JOIN `ideal-data-warehouse.centra.categories` t2 ON t1.incategory = t2.category LEFT JOIN `ideal-data-warehouse.centra.categories` t3 ON t2.incategory = t3.category WHERE t3.NAME='Categories' ORDER BY sort DESC) SELECT array_agg(level2) AS cats, ARRAY_TO_STRING(ARRAY_AGG(sale),'') AS sale, primary_products FROM fruits GROUP BY primary_Products";
  var options = {
    query: query,
    location: 'EU',
  };
  var [job] = await bigquery.createQueryJob(options);
  var [rows] = await job.getQueryResults();
  return rows;
}
