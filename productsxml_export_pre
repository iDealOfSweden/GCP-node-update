exports.productsxml_export = async (req, res) => {
  let lov = [];
  for (var b = 0; b < marketsBQ.length; b++) {
    lov.push(new Promise((resol, rej) => {
      var mrk = marketsBQ[b];
      var file = myBucket.file('/centra/xmlexports/' + mrk.count + 'products.xml');
      var data = "<?xml version='1.0' encoding='UTF-8'?><products>";
      getRoot(mrk).then((rows) => {
        getCats(mrk.short).then((cats) => {
          var i = 0;
          while (i < rows.length) {
            var desc = htmlToText(rows[i].description, {wordwrap: false});
            var cat = cats.find(element => element.primary_products == rows[i].dispid);
            let categories = "";
            let salecategories = "";
            let model = "";
            let media = "";

            if (rows[i].sa_phone_compatibility != "" && rows[i].sa_phone_compatibility != null) model = rows[i].sa_phone_compatibility.substring(0,rows[i].sa_phone_compatibility.indexOf(' '));
            else model = rows[i].sa_model;
            
            for (var s = 0; s < rows[i].additional_image_links.length; s++) {
              media += "<additional_image_link>" + rows[i].additional_image_links[s] + "</additional_image_link>"
            }
            if (typeof cat != 'undefined') {
              salecategories = cat.sale
              for (var p = 0; p < cat.cats.length; p++) {
                categories += "<category_" + p + ">" + cat.cats[p] + "</category_" + p + ">"
              }
            }
            
            var googleid = "<custom_google_id>" + "1/" + mrk.short + "-p" + rows[i].productId + "-v" + rows[i].dispid + "-s" + "</custom_google_id>"
            let predat = "<product><brandname>" + rows[i].brandname + "</brandname><createdAt>" + rows[i].createdAt + "</createdAt><ean>" + rows[i].ean + "</ean><google_merchant_category>" + rows[i].google_merchant_category + "</google_merchant_category>"+ googleid +"<productid>" + rows[i].productId + "</productid><sa_dynamic_badges>" + rows[i].sa_dynamic_badges + "</sa_dynamic_badges><pattern_group_brand_out>" + rows[i].sa_type + " (" + model + ") - " + rows[i].sa_pattern + "</pattern_group_brand_out><productname>" + rows[i].product + "</productname>" + categories + "<category_sale>" + salecategories + "</category_sale>" +"<sa_algolia_ranking>" + rows[i].sa_algolia_ranking + "</sa_algolia_ranking><collection>" + rows[i].collection + "</collection><sa_collection>" + rows[i].sa_collection + "</sa_collection><sa_family>" + rows[i].sa_family + "</sa_family><sa_gender>" + rows[i].sa_gender + "</sa_gender><sa_hidden>" + rows[i].sa_hidden + "</sa_hidden><bestseller>" + rows[i].bestseller + "</bestseller><male_bestseller>" + rows[i].male_bestseller + "</male_bestseller><sa_manufacturer>" + rows[i].sa_manufacturer + "</sa_manufacturer><sa_model>" + rows[i].sa_model + "</sa_model><sa_new_product>" + rows[i].sa_new_product + "</sa_new_product><sa_pattern>" + rows[i].sa_pattern + "</sa_pattern><sa_phone_compatibility>" + rows[i].sa_phone_compatibility + "</sa_phone_compatibility><sa_product_group>" + rows[i].sa_product_group + "</sa_product_group><sa_type>" + rows[i].sa_type + "</sa_type><sku>" + rows[i].sku + "</sku><mpn>" + rows[i].mpn + "</mpn><weight>" + rows[i].weight + "</weight><availability>" + rows[i].availability + "</availability><description>" + desc.replace(/&/g, "&amp;") + "</description><image_link>" + rows[i].image_link + "</image_link>" + media + "<link>" + rows[i].link + "</link><price>" + rows[i].price + "</price><sale_price>" + rows[i].sale_price + "</sale_price><sale_price_effective_date>" + rows[i].sale_price_effective_date + "</sale_price_effective_date>